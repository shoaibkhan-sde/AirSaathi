# ====================================================================
# AirSaathi - Environment Configuration
# ====================================================================
# Free Open-Meteo API (Default):
# No API key is required. Free non-commercial Open-Meteo geocoding and
# air-quality endpoints will be used automatically.

# Optional Commercial Subscription (Leave empty for standard free usage):
OPEN_METEO_API_KEY=
OPEN_METEO_API_BASE_URL=https://customer-api.open-meteo.com

# Server Port (When running standalone backend)
PORT=3001

# Google Gemini API Key for AirSaathi Assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
