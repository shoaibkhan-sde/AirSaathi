{
  "name": "airsaathi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && esbuild server/serverlessHandler.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=api/index.js",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:unit": "node --experimental-strip-types --test tests/*Unit*.test.ts tests/aqiBoundaries.test.ts tests/locationValidation.test.ts tests/homeRecommendations.test.ts tests/indoorAirEngine.test.ts tests/smartTipsEngine.test.ts tests/sustainabilityEngine.test.ts tests/storage*.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/integration*.test.ts tests/providerIntegration.test.ts tests/apiRoutes.test.ts",
    "test:e2e": "node --experimental-strip-types --test tests/e2e*.test.ts",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ioredis": "^4.28.10",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "postcss": "^8.4.49",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
